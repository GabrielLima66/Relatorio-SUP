QUALITOR_PASSWORD=troque-me
QUALITOR_COMPANY=1
QUALITOR_CUSTOMER=0
QUALITOR_SCOPE=USER

# senha compartilhada que protege o dashboard inteiro (tela de login)
ADMIN_PASSWORD=troque-me
# APP_SECRET_KEY não entra aqui — é gerada sozinha no primeiro boot do app.py
